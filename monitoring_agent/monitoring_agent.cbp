<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="monitoring_agent" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/monitoring_agent" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc-mingw64" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add option="-lws2_32" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/monitoring_agent" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="NetworkClient.cpp" />
		<Unit filename="NetworkClient.h" />
		<Unit filename="SystemMonitor.cpp" />
		<Unit filename="SystemMonitor.h" />
		<Unit filename="main.cpp" />
		<Unit filename="packet.h" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
